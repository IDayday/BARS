{
  "_extends_note": "Use this as a template for cached diagnostics reruns. It mirrors d4rl_antmaze_quick but defaults to reachability-only diagnostics and stronger nonzero path sampling.",
  "seed": 0,
  "device": "cuda",
  "data": {
    "source": "d4rl",
    "env_name": "antmaze-medium-play-v2",
    "dataset_limit": 0
  },
  "graph": {
    "load_if_exists": true,
    "spectral_mode": "landmark",
    "spectral_max_nodes": 4096,
    "spectral_eig_tol": 0.001,
    "spectral_eig_maxiter": 1500,
    "trajectory_stratified_support": true
  },
  "boundary": {
    "enabled": false,
    "method": "none"
  },
  "planner": {
    "variant": "reachability",
    "lambda_risk": 1.0,
    "lambda_boundary": 0.0
  },
  "diagnostics": {
    "enabled": true,
    "planner_variants": ["shortest", "reachability"],
    "num_path_pairs": 128,
    "path_min_dt": 50,
    "path_max_dt": 160,
    "path_min_graph_edges": 1,
    "path_include_zero_pairs": false,
    "path_max_sampling_attempts": 4096,
    "edge_label_horizon": 30,
    "edge_selected_threshold": 0.5,
    "balanced_edge_diag": true,
    "balanced_edge_num_pos": 4096,
    "balanced_edge_num_neg": 4096,
    "balanced_edge_num_unlabeled": 4096,
    "balanced_edge_hard_neg_knn": 16
  },
  "eval": {
    "enabled": false
  }
}
